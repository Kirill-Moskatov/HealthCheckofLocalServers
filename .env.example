# Pulse — переменные окружения
# Скопируйте этот файл в .env и заполните значения

# Приложение
APP_NAME=Pulse
DEBUG=False

# База данных
DATABASE_URL=sqlite+aiosqlite:///./pulse.db

# Проверки сервисов
CHECK_INTERVAL_MINUTES=20
CHECK_TIMEOUT_SECONDS=10

# Уведомления (мок)
MAX_BOT_TOKEN=

# URL сервисов для проверки (KeenDNS-адреса)
# HOME_ASSISTANT_URL=https://ha.yourdomain.keenetic.link
# IMMICH_URL=https://immich.yourdomain.keenetic.link
